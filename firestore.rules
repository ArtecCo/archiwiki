rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.active == true;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function resourceBelongsToUser() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    function incomingBelongsToUser() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /notes/{noteId} {
      allow create: if isAuthenticated()
        && incomingBelongsToUser()
        && request.resource.data.keys().hasAll(['title', 'body', 'userId', 'folderId', 'updatedAt']);
      allow read, update, delete: if isAuthenticated()
        && resourceBelongsToUser();
    }

    match /folders/{folderId} {
      allow create: if isAuthenticated()
        && incomingBelongsToUser()
        && request.resource.data.keys().hasAll(['name', 'parentId', 'userId']);
      allow read, update, delete: if isAuthenticated()
        && resourceBelongsToUser();
    }

    match /adminUsers/{adminId} {
      allow read: if isAuthenticated() && request.auth.uid == adminId;
      allow create, update, delete: if false;
    }

    match /locks/{noteId} {
      allow read: if isAuthenticated() && resourceBelongsToUser();
      allow create: if isAuthenticated() && incomingBelongsToUser();
      allow update, delete: if isAuthenticated() && resourceBelongsToUser();
    }

    match /metrics/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /pendingInvites/{token} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin();

      allow update: if isAuthenticated()
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'used',
            'status',
            'claimId',
            'claimedAt',
            'usedBy',
            'usedEmail',
            'usedAt'
          ]);

      allow delete: if false;
    }

    // Maintenance status must be readable before login so the application
    // can show the maintenance screen to unauthenticated users.
    // Only an active admin can enable or disable maintenance mode.
    match /adminMetrics/maintenance {
      allow get: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }
  }
}