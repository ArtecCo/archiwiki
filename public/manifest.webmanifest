{
  "id": "/",
  "name": "ArchiWiki",
  "short_name": "ArchiWiki",
  "description": "An elegant, zero-knowledge encrypted Markdown note-taking PWA.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait-primary",
  "theme_color": "#F5F2EB",
  "background_color": "#F5F2EB",
  "icons": [
    {
      "src": "/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
